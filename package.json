{
  "name": "@ying/pet-phone-checkpoint",
  "version": "0.1.0",
  "description": "从 pet-phone 拆出的独立检查点组件：任务中途，停一下，听一下。工具返回后把外部未读消息追加进结果——只挂 post-execute，数据源外部，过期自灭，失败静默。",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinfandi/pet-phone-checkpoint.git"
  },
  "homepage": "https://github.com/yinfandi/pet-phone-checkpoint#readme",
  "bugs": {
    "url": "https://github.com/yinfandi/pet-phone-checkpoint/issues"
  },
  "keywords": [
    "dsh-plugin",
    "checkpoint",
    "post-execute",
    "unread",
    "mid-task",
    "pet-phone"
  ],
  "main": "./src/index.mjs",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.mjs",
    "src/source.mjs",
    "src/warrants.mjs",
    "src/checkpoint.mjs",
    "src/reply.mjs",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "docs/SPEC.md",
    "dist/build-info.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test-all.mjs",
    "tidy": "node scripts/tidy-check.mjs"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  }
}
